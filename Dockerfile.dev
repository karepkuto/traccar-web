FROM node:22-alpine

WORKDIR /app

# git dipakai vite.config.js untuk membaca hash, tanggal & pesan commit
# (ditampilkan sebagai info versi di website). safe.directory perlu karena
# folder /app di-mount dari host dengan owner berbeda.
RUN apk add --no-cache git && git config --global --add safe.directory /app

# Copy package files dulu supaya layer cache npm install tidak perlu diulang
# kalau cuma source code yang berubah
COPY package*.json ./
RUN npm install

# Source code di-mount lewat volume (lihat docker-compose.dev.yml),
# jadi tidak perlu di-copy di sini untuk mode dev.

EXPOSE 3000

CMD ["npm", "start"]
